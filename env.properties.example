# ============================================================
# Ekip Arkadaşları İçin ÖRNEK Ayar Dosyası
# ============================================================
# KURULUM:
# 1. Bu dosyayı aynı klasörde kopyalayıp adını "env.properties" yapın.
# Public example configuration. Put real local values only in ignored env.properties.
spring.profiles.active=local
# 3. Projeyi çalıştırın: mvn spring-boot:run
# ============================================================

DB_URL=jdbc:mysql://localhost:3306/depo_yonetim?useSSL=false&serverTimezone=UTC
DB_HOST=localhost
DB_PORT=3306
DB_NAME=depo_yonetim
DB_USERNAME=replace-with-db-username
DB_PASSWORD=replace-with-db-password
JWT_SECRET=replace-with-a-generated-64-character-secret
DB_SSL_MODE=REQUIRED
MYSQLDUMP_PATH=C:/path/to/mysqldump

# Ollama belge ayrıştırma ayarları (opsiyonel)
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CHUNK_SIZE_ROWS=10
OLLAMA_PARALLEL_REQUESTS=2
OLLAMA_TEXT_CHUNK_MAX_CHARS=12000
OLLAMA_PDF_TEXT_CHUNK_MAX_CHARS=2000
OLLAMA_PDF_RECORDS_PER_CHUNK=5
OLLAMA_MAX_RETRIES=2
OLLAMA_STRUCTURED_OUTPUT_ENABLED=true
